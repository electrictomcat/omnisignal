APP_NAME="OmniSignal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=https://omnisignal.dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Database (PostgreSQL for Local & Laravel Cloud)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=omnisignal
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# Lemon Squeezy Merchant of Record & Licensing
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=463287
LEMON_SQUEEZY_SIGNING_SECRET=
LEMON_SQUEEZY_VARIANT_STARTER=
LEMON_SQUEEZY_VARIANT_PRO=
LEMON_SQUEEZY_VARIANT_AGENCY=

# OmniSignal Channels Configuration
AD_CONVERSIONS_DEFAULT_CHANNEL=google
AD_CONVERSIONS_DASHBOARD_ENABLED=true

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEFAULT_CURRENCY=USD
GOOGLE_ADS_COOKIE_CONSENT=always
GOOGLE_ADS_RETENTION_DAYS=90
GOOGLE_ADS_ENHANCED_CONVERSIONS=false

# Meta (Facebook & Instagram) Conversions API (CAPI)
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# Microsoft (Bing) Advertising
MICROSOFT_ADS_DEVELOPER_TOKEN=
MICROSOFT_ADS_CUSTOMER_ID=
MICROSOFT_ADS_ACCESS_TOKEN=

# LinkedIn Conversions API
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_CONVERSION_RULE_ID=

# TikTok Events API
TIKTOK_PIXEL_CODE=
TIKTOK_ACCESS_TOKEN=
