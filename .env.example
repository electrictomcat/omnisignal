APP_NAME="OmniSignal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=https://omnisignal.dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Database (PostgreSQL for Local & Laravel Cloud)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=omnisignal
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Must be true in production. Without it the session cookie is sent over
# plain HTTP if anything ever downgrades the connection.
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# Mail. `log` is fine locally, but the licence portal proves ownership by
# emailing a signed link, so a production deploy still on `log` locks every
# customer out of their own licence keys. Set a real transport before shipping.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="support@omnisignal.dev"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------
# Lemon Squeezy — merchant of record & licensing
# ------------------------------------------------------------------------

LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_STORE_URL=https://omnisignal.lemonsqueezy.com

# REQUIRED. Webhooks are rejected outright when this is unset — an unsigned
# order_created would otherwise mint a licence to anyone who can POST.
# Copy it from Lemon Squeezy > Settings > Webhooks.
LEMON_SQUEEZY_SIGNING_SECRET=

# Variant IDs per tier. Subscription and one-time are separate variants.
LEMON_SQUEEZY_STARTER_SUBSCRIPTION=
LEMON_SQUEEZY_STARTER_ONE_TIME=
LEMON_SQUEEZY_PRO_SUBSCRIPTION=
LEMON_SQUEEZY_PRO_ONE_TIME=
LEMON_SQUEEZY_AGENCY_SUBSCRIPTION=
LEMON_SQUEEZY_AGENCY_ONE_TIME=

# Optional product IDs, used to classify an order whose variant is unknown.
LEMON_SQUEEZY_STARTER_PRODUCT=
LEMON_SQUEEZY_PRO_PRODUCT=
LEMON_SQUEEZY_AGENCY_PRODUCT=

# ------------------------------------------------------------------------
# OmniSignal channels
# ------------------------------------------------------------------------

AD_CONVERSIONS_DEFAULT_CHANNEL=google

# Internal analytics dashboard. Off by default; it exposes lead counts,
# click identifiers and attributed revenue, and is behind `auth` when on.
AD_CONVERSIONS_DASHBOARD_ENABLED=false
AD_CONVERSIONS_DASHBOARD_PATH=ad-conversions

# Google Ads — hosted connector.
#
# Customers authorise their own Google Ads account at /portal and we upload on
# their behalf, because the OAuth client secret cannot ship inside a GPL
# WordPress plugin and the developer token is issued against our manager
# account rather than each customer's. These are ours, not per-tenant.
GOOGLE_ADS_OAUTH_CLIENT_ID=
GOOGLE_ADS_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_API_VERSION=v23

# Google Ads — this application's own conversion tracking (optional).
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEFAULT_CURRENCY=USD
GOOGLE_ADS_COOKIE_CONSENT=always
GOOGLE_ADS_RETENTION_DAYS=90
GOOGLE_ADS_ENHANCED_CONVERSIONS=false

# Country calling code assumed for phone numbers stored without one
# (1 = US, 44 = UK). Numbers that cannot be resolved to E.164 are dropped
# rather than hashed under a guessed country, which would match nobody.
GOOGLE_ADS_DEFAULT_CALLING_CODE=

# Meta (Facebook & Instagram) Conversions API
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# Microsoft (Bing) Advertising — the manager ID and the ad account ID are
# different values and ApplyOfflineConversions needs both.
MICROSOFT_ADS_DEVELOPER_TOKEN=
MICROSOFT_ADS_CUSTOMER_ID=
MICROSOFT_ADS_ACCOUNT_ID=
MICROSOFT_ADS_ACCESS_TOKEN=

# LinkedIn Conversions API. Roll the version forward when calls start
# returning 426; LinkedIn retires a version about a year after release.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_CONVERSION_RULE_ID=
LINKEDIN_API_VERSION=202608

# TikTok Events API
TIKTOK_PIXEL_CODE=
TIKTOK_ACCESS_TOKEN=
