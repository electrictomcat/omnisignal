{
    "name": "omnisignal/php-sdk",
    "description": "Zero-dependency Universal PHP SDK for OmniSignal server-side offline conversion tracking across Google Ads, Meta CAPI, TikTok, LinkedIn, and Microsoft Ads.",
    "keywords": ["omnisignal", "offline-conversions", "meta-capi", "google-ads", "tiktok-events", "conversion-tracking"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OmniSignal Team",
            "email": "support@omnisignal.dev",
            "homepage": "https://omnisignal.dev"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "OmniSignal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OmniSignal\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
